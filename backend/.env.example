# Local development only. Do not commit your real .env
POSTGRES_DB=hrm_dev
POSTGRES_USER=hrm_app
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=5433
FRONTEND_PORT=5173
BACKEND_URL=http://localhost:8080
DB_URL=jdbc:postgresql://localhost:5433/hrm_dev
DB_USERNAME=hrm_app
DB_PASSWORD=local_only_change_me
SERVER_PORT=8080
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
PLATFORM_ADMIN_EMAILS=

LOCAL_DB_URL='jdbc:postgresql://localhost:5432/hrm_dev'
LOCAL_DB_USERNAME='hrm_owner'
LOCAL_DB_PASSWORD='hrm_app'
# Platform operations: generate an age key pair and keep the identity private.
APP_BACKUP_AGE_RECIPIENT=
APP_BACKUP_AGE_IDENTITY=
APP_BACKUP_DIRECTORY=./data/backups
# Dedicated read-only PostgreSQL account used only by pg_dump. Provision it with
# backend/scripts/provision-backup-db-role.sql; do not reuse DB_USERNAME/DB_PASSWORD.
APP_BACKUP_DB_URL=
APP_BACKUP_DB_USERNAME=hrm_backup
APP_BACKUP_DB_PASSWORD=
# Generate a base64-encoded 32-byte key for encrypting stored platform secrets.
HRM_MFA_ENCRYPTION_KEY=
